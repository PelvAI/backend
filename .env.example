# ALMA Backend — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://alma:alma_secret@localhost:5432/alma_db

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key for JWT signing — generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ─── App Config ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
ENVIRONMENT=development

# Origins allowed to make CORS requests (comma-separated)
# Example for production: https://admin.sci4women.com,https://alma.sci4women.com
ALLOWED_ORIGINS=http://localhost:3000
