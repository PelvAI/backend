# Vela Backend - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/vela_db

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key for JWT signing — generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ─── App Config ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
ENVIRONMENT=development

# Origins allowed to make CORS requests (comma-separated)
# Example for production: https://admin.vela.com,https://app.vela.com
ALLOWED_ORIGINS=http://localhost:3000
