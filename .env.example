# ALMA Backend — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver)
# Host local: 5433 (docker-compose mapeia 5433→5432; 5432 costuma ser o Postgres do ChatBot)
# Dentro do Compose a API usa @db:5432 (ver docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://alma:alma_secret@localhost:5433/alma_db

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key for JWT signing — generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ─── App Config ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
ENVIRONMENT=development

# Origins allowed to make CORS requests (comma-separated)
# Example for production: https://admin.sci4women.com,https://alma.sci4women.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Chatbot (PelvAI) ─────────────────────────────────────────────────────────
# URL base SEM path /api (o chatbot expõe /chat e /health na raiz)
CHATBOT_BASE_URL=http://127.0.0.1:8000
# Mesmo valor que ALMA_SERVICE_TOKEN no projecto ChatBot
CHATBOT_SERVICE_TOKEN=change-me-long-random-shared-secret-min-32-chars
CHATBOT_TIMEOUT_SECONDS=120
# Timeout só do POST de upload RAG (não aplica ao chat)
CHATBOT_UPLOAD_TIMEOUT_SECONDS=600
# Se true, /send falha se o chatbot estiver em baixo (recomendado em staging/prod)
CHATBOT_REQUIRED=true
